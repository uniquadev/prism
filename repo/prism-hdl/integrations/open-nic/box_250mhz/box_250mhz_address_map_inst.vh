localparam integer PRISM_AXIL_INTERFACES = NUM_CMAC_PORT * 2;
wire [PRISM_AXIL_INTERFACES-1:0] axil_prism_awvalid;
wire [32*PRISM_AXIL_INTERFACES-1:0] axil_prism_awaddr;
wire [PRISM_AXIL_INTERFACES-1:0] axil_prism_awready;
wire [PRISM_AXIL_INTERFACES-1:0] axil_prism_wvalid;
wire [32*PRISM_AXIL_INTERFACES-1:0] axil_prism_wdata;
wire [PRISM_AXIL_INTERFACES-1:0] axil_prism_wready;
wire [PRISM_AXIL_INTERFACES-1:0] axil_prism_bvalid;
wire [2*PRISM_AXIL_INTERFACES-1:0] axil_prism_bresp;
wire [PRISM_AXIL_INTERFACES-1:0] axil_prism_bready;
