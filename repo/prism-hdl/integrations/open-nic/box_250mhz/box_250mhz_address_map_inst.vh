wire [2*PRISM_AXIL_INTERFACES-1:0] axil_prism_rresp;
wire [PRISM_AXIL_INTERFACES-1:0] axil_prism_rready;

assign axil_prism_awvalid = {{(PRISM_AXIL_INTERFACES-1){1'b0}}, s_axil_awvalid};
assign axil_prism_awaddr = {{32*(PRISM_AXIL_INTERFACES-1){1'b0}}, s_axil_awaddr};
assign s_axil_awready = axil_prism_awready[0];
assign axil_prism_wvalid = {{(PRISM_AXIL_INTERFACES-1){1'b0}}, s_axil_wvalid};
assign axil_prism_wdata = {{32*(PRISM_AXIL_INTERFACES-1){1'b0}}, s_axil_wdata};
assign s_axil_wready = axil_prism_wready[0];
